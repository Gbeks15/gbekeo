---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { site, contactHref } from '../site.config';

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const solo = all.filter((p) => p.data.group === 'solo' && p.data.status !== 'On hold');
const onHold = all.filter((p) => p.data.group === 'solo' && p.data.status === 'On hold');
const vista = all.filter((p) => p.data.group === 'vista');
---
<Base>
  <header class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="label">senior product manager / ai builder / dubai</p>
        <h1>{site.name}</h1>
        <p class="role">Senior Product Manager. <span>AI Builder.</span></p>
        <p class="lede">
          8+ years shipping products inside a $10B global aviation group.
          <em>Now I build my own. End to end.</em>
        </p>
        <div class="cta-row">
          <a href="#built" class="btn primary">See what I've built ↓</a>
          <a href={contactHref} class="btn">Let's talk</a>
        </div>
      </div>
      <img class="hero-photo" src="/img/gbeke.jpg" alt="Gbeke Odubanjo" width="640" height="640" />
    </div>
  </header>

  <section class="block intro">
    <div class="wrap">
      <p class="label">about</p>
      <p><strong>I've spent my career turning messy problems into products people actually use.</strong> Across aviation, compliance, fintech and AI.</p>
      <p>I've sat with engineers, UX/UI designers, compliance teams and the C-suite. I know how each of them thinks, and what it takes to get them building the same thing.</p>
      <p class="kicker">These days I don't just write the spec.<br /><span>I build the thing.</span></p>
    </div>
  </section>

  <section class="block" id="think">
    <div class="wrap think">
      <div>
        <p class="label">how i think</p>
        <h2>Every product starts with a problem.</h2>
        <p class="big">Get that wrong and nothing else matters.</p>
      </div>
      <div>
        <p class="big-lead">For me, the key to any product is simple. Understand the problem it's trying to solve, and the value it brings.</p>
        <p>Not the features. Not the tech. The problem.</p>
        <p>So before anything gets built, I want to know:</p>
        <ul class="qs">
          <li><span>01</span>What's the problem we're trying to solve?</li>
          <li><span>02</span>Who's impacted most?</li>
          <li><span>03</span>What changes for them when it's fixed?</li>
        </ul>
        <p>If I can't answer those, we're not ready to build.</p>
        <p>Once I can, I move fast. Prototype, test, ship, learn. Then go again.</p>
        <p>I don't measure a product by whether it launched. I measure it by the value it's brought. Hours saved. Revenue unlocked. Risk removed. People who use it every day without being told to.</p>
        <p class="closing">That's the part I genuinely love. Taking something that frustrates people every day and making it just....work.</p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <p class="label">by the numbers</p>
      <div class="numbers">
        <div><b>117 hrs</b><span>a week of manual work removed by an automated sales quoting product</span></div>
        <div><b>$1.2M</b><span>a month in revenue running through that product</span></div>
        <div><b>€20M</b><span>of regulatory exposure covered by sanctions screening I launched</span></div>
        <div><b>1,000+</b><span>trades synced and reviewed live in RIFT</span></div>
      </div>
    </div>
  </section>

  <section class="block" id="built">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">built solo</p>
          <h2>Things I've built myself.</h2>
          <p>Idea, product, design, code, infrastructure. All live in production.</p>
        </div>
      </div>
      <div class="solo-grid">
        {solo.map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">shipped at vista</p>
          <h2>Products at scale.</h2>
          <p>8+ years at Vista Global, the group behind VistaJet. Real users, real regulators, real money.</p>
        </div>
      </div>
      <div class="vista">
        {vista.map((p, i) => (
          <div class="vista-row">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.summary}</p>
            <span class="m">{p.data.metric ?? ''}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {onHold.length > 0 && (
    <section class="block">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="label">on hold</p>
            <h2>Paused, not forgotten.</h2>
          </div>
        </div>
        <div class="hold-grid">
          {onHold.map((p) => <ProjectCard p={p} />)}
        </div>
      </div>
    </section>
  )}

  <section class="block contact" id="contact">
    <div class="wrap">
      <p class="label">contact</p>
      <h2>Got a problem worth solving?<span>I'd love to hear about it.</span></h2>
      <div class="cta-row">
        <a href={contactHref} class="btn primary">Let's talk</a>
        <a href={site.linkedin} class="btn" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a href={site.cv} class="btn" download="Gbeke Odubanjo - Senior Product Manager CV.pdf" target="_blank" rel="noopener">Download CV</a>
      </div>
    </div>
  </section>
</Base>
